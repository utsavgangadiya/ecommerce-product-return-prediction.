# Keep only the model and metrics needed by the deployed dashboard.
models/*
!models/best_return_detection_model.joblib
!models/two_model_comparison_metrics.csv
!models/dashboard_insights.json

# OS files
.DS_Store
Thumbs.db
Desktop.ini
